<Window x:Class="SimilarVideoFinder.App.Subtitles.ForcedSubtitlesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Forced Subtitle Generator — MediaForge" Width="940" Height="850" MinWidth="820" MinHeight="680"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}">
 <Grid Background="{DynamicResource WindowBackground}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" Padding="24,18">
   <StackPanel>
    <TextBlock Text="Forced Subtitle Generator" Foreground="{DynamicResource HeaderForeground}" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource HeaderMuted}" TextWrapping="Wrap"
     Text="Translate foreign-language speech on an English audio track into an English forced SRT."/>
   </StackPanel>
  </Border>
  <ScrollViewer Grid.Row="1" Margin="24,16,24,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="OptionsPanel">
    <TextBlock Text="Video or folder (includes subfolders)"/>
    <DockPanel Margin="0,6,0,12">
     <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Choose folder…" Click="BrowseFolder_Click"/>
     <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Choose video…" Click="BrowseVideo_Click"/>
     <TextBox x:Name="InputBox"/>
    </DockPanel>
    <TextBlock Text="Python executable"/>
    <TextBox x:Name="PythonBox" Text="python.exe" Margin="0,6,0,6"/>
    <TextBlock Text="One-time Python setup" Foreground="{DynamicResource MutedBrush}"/>
    <TextBox Text="python -m pip install faster-whisper==1.2.1" IsReadOnly="True" Margin="0,4,0,12"/>
    <WrapPanel>
     <StackPanel Margin="0,0,12,0">
      <TextBlock Text="Preset model"/>
      <ComboBox x:Name="ModelBox" SelectedIndex="1" Width="145" Margin="0,6,0,0" SelectionChanged="ModelSelection_Changed">
       <ComboBoxItem Content="small"/><ComboBoxItem Content="medium"/><ComboBoxItem Content="large-v3"/>
      </ComboBox>
     </StackPanel>
     <StackPanel Margin="0,0,12,0">
      <TextBlock Text="Device"/>
      <ComboBox x:Name="DeviceBox" SelectedIndex="0" Width="145" Margin="0,6,0,0">
       <ComboBoxItem Content="CPU"/><ComboBoxItem Content="NVIDIA CUDA"/>
      </ComboBox>
     </StackPanel>
     <StackPanel>
      <TextBlock Text="Audio track (0 = automatic)"/>
      <TextBox x:Name="TrackBox" Text="0" Margin="0,6,0,0" ToolTip="Enter the 1-based audio track number to override automatic English track selection."/>
     </StackPanel>
    </WrapPanel>
    <TextBlock Margin="0,12,0,0" Text="Model download folder"/>
    <DockPanel Margin="0,6,0,0">
     <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Choose storage…" Click="BrowseStorage_Click"/>
     <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Open model storage" Click="OpenModels_Click"/>
     <TextBox x:Name="ModelStorageBox" TextChanged="ModelStorage_Changed" ToolTip="Defaults to MediaForge-Data\models beside the EXE."/>
    </DockPanel>
    <DockPanel Margin="0,8,0,0">
     <Button x:Name="DownloadModelButton" DockPanel.Dock="Right" Content="Download selected model" Click="DownloadModel_Click" Margin="12,0,0,0"/>
     <TextBlock x:Name="ModelStatusText" Text="Checking downloaded models…" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
    </DockPanel>
    <TextBlock Text="A missing preset downloads automatically before generation. Model downloads can use several GB. Once downloaded, it can be used offline." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/>
    <TextBlock Margin="0,12,0,0" Text="Local model folder (optional, overrides the preset)"/>
    <DockPanel Margin="0,6,0,0">
     <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Choose model…" Click="BrowseModel_Click"/>
     <TextBox x:Name="LocalModelBox" ToolTip="Choose the folder containing the converted Whisper model files."/>
    </DockPanel>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="24,4,24,10">
   <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="6" Margin="0,12,0,0" Visibility="Collapsed"/>
   <TextBlock x:Name="DownloadProgressText" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed"/>
   <StackPanel Orientation="Horizontal" Margin="0,14,0,8">
    <Button x:Name="StartButton" Content="Generate forced SRT" Click="Start_Click"/>
    <Button x:Name="CancelButton" Margin="8,0,0,0" Content="Cancel" IsEnabled="False" Click="Cancel_Click"/>
   </StackPanel>
   <TextBlock x:Name="StatusText" Text="Outputs are saved beside the videos as .en.forced.srt." TextWrapping="Wrap"/>
  </StackPanel>
  <TextBox x:Name="LogBox" Grid.Row="3" Margin="24,0,24,18" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
 </Grid>
</Window>
