<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>MediaForge</AssemblyName>
    <Product>MediaForge</Product>
    <Description>Modular Media Management Suite</Description>
    <RootNamespace>SimilarVideoFinder.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <Version>3.2.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('../assets/mediaforge.ico')">../assets/mediaforge.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../assets/mediaforge.png" LogicalName="Branding.MediaForge.png" Condition="Exists('../assets/mediaforge.png')" />
    <ProjectReference Include="../Core/SimilarVideoFinder.Core.csproj" />
    <ProjectReference Include="../Tooling/MediaForge.Tooling.csproj" />
    <ProjectReference Include="../Integrity/MediaForge.Integrity.csproj" />
    <EmbeddedResource Include="Subtitles/forced_subtitles.py" LogicalName="Tools.forced_subtitles.py" />
    <EmbeddedResource Include="../vendor/ffmpeg.exe" LogicalName="Tools.ffmpeg.exe" />
    <EmbeddedResource Include="../vendor/ffprobe.exe" LogicalName="Tools.ffprobe.exe" />
    <EmbeddedResource Include="../vendor/tool-checksums.json" LogicalName="Tools.checksums.json" />
    <EmbeddedResource Include="../vendor/FFmpeg-LICENSE.txt" LogicalName="Notices.FFmpeg.txt" />
    <EmbeddedResource Include="../THIRD-PARTY-NOTICES.txt" LogicalName="Notices.All.txt" />
  </ItemGroup>
</Project>
