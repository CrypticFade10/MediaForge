<Window x:Class="SimilarVideoFinder.App.Shell.SuiteWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MediaForge" Width="1040" Height="700" MinWidth="760" MinHeight="500"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}">
 <Grid Background="{DynamicResource WindowBackground}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource HeaderBackground}" Padding="32,28">
   <Grid>
    <StackPanel>
     <TextBlock Text="MEDIAFORGE" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HeaderMuted}"/>
     <TextBlock Text="Modular Media Management Suite" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,8" Foreground="{DynamicResource HeaderForeground}"/>
     <TextBlock Text="One application. A growing collection of useful tools." Foreground="{DynamicResource HeaderMuted}"/>
    </StackPanel>
    <CheckBox x:Name="DarkModeToggle" Content="Dark mode" HorizontalAlignment="Right" VerticalAlignment="Top"
      Foreground="{DynamicResource HeaderForeground}" Click="DarkMode_Click"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="32,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="Choose a tool" FontSize="22" FontWeight="SemiBold"/>
   <Grid Grid.Row="1" Margin="0,16,0,18">
    <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Search tools by name, description or category" AutomationProperties.Name="Search tools"/>
    <TextBlock Text="Search tools." Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <ItemsControl x:Name="ToolCards">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,14">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,24,0">
          <TextBlock Text="{Binding Category}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
          <TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,10"/>
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"/>
         </StackPanel>
         <Button Grid.Column="1" Content="Open tool" Tag="{Binding Id}" Click="OpenTool_Click" VerticalAlignment="Center" Margin="0" AutomationProperties.Name="{Binding Name}"/>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock x:Name="EmptyText" Text="No tools match your search." Visibility="Collapsed" Foreground="{DynamicResource MutedBrush}"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Padding="32,16" Background="{DynamicResource Surface}">
   <Grid>
    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
    <TextBlock Text="Standalone Windows suite" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
   </Grid>
  </Border>
 </Grid>
</Window>
